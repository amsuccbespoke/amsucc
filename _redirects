# ===== FAWLUX REDIRECTS =====

# Redirect netlify.app to custom domain (301 permanent)
https://fawlux.netlify.app/* https://fawlux.com.ng/:splat 301!
http://fawlux.netlify.app/* https://fawlux.com.ng/:splat 301!

# Force HTTPS for all traffic
http://*.fawlux.com.ng/* https://fawlux.com.ng/:splat 301!

# Redirect www to non-www
https://www.fawlux.com.ng/* https://fawlux.com.ng/:splat 301!
http://www.fawlux.com.ng/* https://fawlux.com.ng/:splat 301!

# Redirect /index.html to root
/index.html / 301!

# Serve root with index.html (REQUIRED for homepage to load)
/ /index.html 200